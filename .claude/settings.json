{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/build.mjs\" --auto || exit 2",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
