{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent config",
  "description": "Per-user settings for bin/build.mjs. The configure skill and the settings page (node bin/ui.mjs) write this file; a missing file means every default below.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "language": {
      "description": "The language the agent replies in. Code, commits, and pull requests stay in English.",
      "type": "string",
      "minLength": 1,
      "default": "English"
    },
    "local": {
      "description": "Optional Git repository whose root supplies local/.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "description": "HTTPS or SSH Git URL. A normal build clones or fast-forwards local/; automatic builds never use the network. Existing edits and local commits are kept. Empty or null disables downloading without deleting local/.",
          "type": ["string", "null"],
          "default": null
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabled": {
          "description": "Skills under skills/ that the build leaves out.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "effort": {
      "description": "Reasoning effort of Claude Code and Codex subagents. The main session keeps its own level.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "description": "oneshot-worker, which writes one plan task.",
          "enum": ["low", "medium", "high", "xhigh", "max"],
          "default": "medium"
        },
        "review": {
          "description": "oneshot-reviewer, which runs prod-review on the finished change.",
          "enum": ["low", "medium", "high", "xhigh", "max"],
          "default": "xhigh"
        }
      }
    },
    "externalReview": {
      "description": "Voices the external-review skill runs. Each needs its CLI and a subscription. Enabling a voice is consent to send it sanitized code from any repository. The agent a target serves is always left out of its own review.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "timeoutMinutes": {
              "description": "Minutes this voice may review before it is stopped and reported as timeout.",
              "type": "integer",
              "minimum": 1,
              "maximum": 1440,
              "default": 15
            },
            "model": {
              "type": "string",
              "default": "cursor-grok-4.6-low"
            }
          }
        },
        "grok": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "timeoutMinutes": {
              "description": "Minutes this voice may review before it is stopped and reported as timeout.",
              "type": "integer",
              "minimum": 1,
              "maximum": 1440,
              "default": 20
            },
            "model": {
              "type": "string",
              "default": "grok-4.7"
            },
            "effort": {
              "enum": ["low", "medium", "high", "xhigh"],
              "default": "high"
            }
          }
        },
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "timeoutMinutes": {
              "description": "Minutes this voice may review before it is stopped and reported as timeout.",
              "type": "integer",
              "minimum": 1,
              "maximum": 1440,
              "default": 15
            },
            "model": {
              "type": "string",
              "default": "gpt-6.2-sol"
            },
            "effort": {
              "type": "string",
              "default": "medium"
            }
          }
        },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "timeoutMinutes": {
              "description": "Minutes this voice may review before it is stopped and reported as timeout.",
              "type": "integer",
              "minimum": 1,
              "maximum": 1440,
              "default": 15
            },
            "model": {
              "type": "string",
              "default": "opus"
            },
            "effort": {
              "enum": ["low", "medium", "high", "xhigh", "max"],
              "default": "high"
            }
          }
        }
      }
    },
    "reviewBots": {
      "description": "Review bots that run on the repository's side, as the pr-wait skill treats them. off ignores the bot, wait waits for it once it shows up on a pull request, request also posts its review comment after each push. Their comments are handled in every mode.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude": {
          "enum": ["off", "wait", "request"],
          "default": "wait"
        },
        "cursor": {
          "enum": ["off", "wait", "request"],
          "default": "off"
        },
        "codex": {
          "enum": ["off", "wait", "request"],
          "default": "off"
        }
      }
    },
    "browser": {
      "description": "Points Claude Code, Codex, and Cursor at Tencent BrowserSkill to drive your own Chrome in a background window. Needs the bsk CLI, its Chrome extension, and `bsk install-skill -H claude-code -H codex`.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "attribution": {
      "description": "Lets agents credit themselves in commits and pull requests. Off writes Claude Code's attribution as empty and turns off Cursor's commit and pull request attribution.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "telemetry": {
      "description": "Lets agents send usage data to their vendors. Off sets DISABLE_TELEMETRY for Claude Code and [analytics] enabled = false for Codex.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "guard": {
      "description": "Stops destructive commands in Claude Code and Codex. Refuses a force-push or delete of the default branch, a mirror push, and a recursive delete of /, the home directory, or a repository root. Asks before a hard reset, a forced clean, discarding every change, a forced branch delete, a stash drop, or any other force-push. Codex cannot ask, so it refuses those too.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "autoCompact": {
      "description": "When agents compact the conversation. Without tokens, each agent keeps its own default.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "description": "Claude Code's autoCompactWindow and Codex's model_auto_compact_token_limit.",
          "type": "integer",
          "minimum": 100000,
          "maximum": 1000000
        }
      }
    },
    "oneshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release": {
          "description": "Where an oneshot run ends. pr stops at a ready pull request. production also merges it and checks production, once the gate had nothing to settle, you answered it, or the run follows a plan you approved, in a feature as in a fix. A series whose gate you answered, or whose plan you approved, then releases without its own authorization question. A gate that took its own recommendations while you were away never releases, and a review of an existing pull request never merges.",
          "enum": ["pr", "production"],
          "default": "pr"
        }
      }
    },
    "orchestration": {
      "description": "How an oneshot series runs its stages.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallel": {
          "description": "How many stages a series builds at once, counting those open before their merge is approved. A program.json can set its own.",
          "type": "integer",
          "minimum": 1,
          "default": 4
        }
      }
    },
    "executors": {
      "description": "Which providers lead hands stages to, and the model and effort of each tier. Only enabled ones reach skills/lead/executors.md. The defaults come from one measurement on three solved tasks.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude": {
          "description": "Claude, started through the host's delegate tool.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "lead": {
              "description": "Coordinates a program and takes its decisions. Default opus, high.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "effort": {
                  "enum": ["low", "medium", "high", "xhigh", "max"]
                }
              }
            },
            "build": {
              "description": "Writes the code of a stage. Default opus, medium (sonnet with high effort is a cheaper choice that was correct on all three tasks but slower).",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "effort": {
                  "enum": ["low", "medium", "high", "xhigh", "max"]
                }
              }
            },
            "light": {
              "description": "Read-only work such as search and summaries, never code. Default haiku, high.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "effort": {
                  "enum": ["low", "medium", "high", "xhigh", "max"]
                }
              }
            }
          }
        },
        "codex": {
          "description": "Codex.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "lead": {
              "description": "Coordinates a program and takes its decisions. Default gpt-6.2-sol, high.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "effort": {
                  "enum": ["low", "medium", "high"]
                }
              }
            },
            "build": {
              "description": "Writes the code of a stage. Default gpt-6.2-sol, medium.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "effort": {
                  "enum": ["low", "medium", "high"]
                }
              }
            },
            "light": {
              "description": "Read-only work such as search and summaries, never code. Default gpt-6-luna, high.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "effort": {
                  "enum": ["low", "medium", "high"]
                }
              }
            }
          }
        },
        "grok": {
          "description": "Grok. Off by default: in the measurement it edited and read outside its task.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "lead": {
              "description": "Coordinates a program and takes its decisions. Default grok-4.7, high.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "effort": {
                  "enum": ["low", "medium", "high", "xhigh"]
                }
              }
            },
            "build": {
              "description": "Writes the code of a stage. Default grok-4.7, high.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "effort": {
                  "enum": ["low", "medium", "high", "xhigh"]
                }
              }
            },
            "light": {
              "description": "Read-only work such as search and summaries, never code. Default grok-4.7, high.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "effort": {
                  "enum": ["low", "medium", "high", "xhigh"]
                }
              }
            }
          }
        },
        "cursor": {
          "description": "Cursor. Off by default and never measured, so it has no default models.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "lead": {
              "description": "Coordinates a program and takes its decisions. No default, so the tier is unused until a model is set.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]+$"
                }
              }
            },
            "build": {
              "description": "Writes the code of a stage. No default, so the tier is unused until a model is set.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]+$"
                }
              }
            },
            "light": {
              "description": "Read-only work such as search and summaries, never code. No default, so the tier is unused until a model is set.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]+$"
                }
              }
            }
          }
        }
      }
    },
    "targets": {
      "description": "Which agent homes the build writes into.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude": {
          "description": "Claude Code.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "dir": {
              "type": "string",
              "minLength": 1,
              "default": "~/.claude"
            }
          }
        },
        "codex": {
          "description": "Codex. On by default when its dir exists.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dir": {
              "type": "string",
              "minLength": 1,
              "default": "~/.codex"
            }
          }
        },
        "cursor": {
          "description": "Cursor. On by default when its dir exists.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dir": {
              "type": "string",
              "minLength": 1,
              "default": "~/.cursor"
            }
          }
        },
        "gemini": {
          "description": "Gemini CLI. On by default when its dir exists.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dir": {
              "type": "string",
              "minLength": 1,
              "default": "~/.gemini"
            }
          }
        },
        "copilot": {
          "description": "GitHub Copilot CLI. On by default when its dir exists.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dir": {
              "type": "string",
              "minLength": 1,
              "default": "~/.copilot"
            }
          }
        },
        "opencode": {
          "description": "OpenCode. Reads the Claude Code skills while that target is on, so it gets no copy of its own then. On by default when its dir exists.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dir": {
              "type": "string",
              "minLength": 1,
              "default": "~/.config/opencode"
            }
          }
        },
        "grok": {
          "description": "Grok Build. Reads the Claude Code skills while that target is on, so it gets no copy of its own then. On by default when its dir exists.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dir": {
              "type": "string",
              "minLength": 1,
              "default": "~/.grok"
            }
          }
        }
      }
    }
  }
}
