{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{skills_dir}}/oneshot/hook.sh\" --host codex",
            "timeout": 5,
            "statusMessage": "oner: oneshot run state"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{repo_dir}}/bin/build.mjs\" --auto",
            "timeout": 30,
            "statusMessage": "oner: rebuild skills and rules"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{repo_dir}}/bin/update-check.mjs\"",
            "timeout": 10,
            "statusMessage": "oner: check for updates"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{skills_dir}}/oneshot/hook.sh\" --host codex",
            "timeout": 5,
            "statusMessage": "oner: oneshot run state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{skills_dir}}/oneshot/hook.sh\" --host codex",
            "timeout": 10,
            "statusMessage": "oner: oneshot run state"
          }
        ]
      }
    ]
  }
}
