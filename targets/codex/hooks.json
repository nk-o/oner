{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{skills_dir}}/oneshot/hook.sh\" --host codex",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{repo_dir}}/bin/build.mjs\" --auto",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{repo_dir}}/bin/update-check.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{skills_dir}}/oneshot/hook.sh\" --host codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"{{skills_dir}}/oneshot/hook.sh\" --host codex", "timeout": 10 }
        ]
      }
    ]
  }
}
